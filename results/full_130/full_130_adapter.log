  ┌─ [1msql:[0m [1;35mSELECT
  CASE WHEN ms.layer_idx = 'Confirmed' THEN 'Confirmed' ELSE 'Suspected' END AS layering_group,
  AVG(
    (tr.vol_day / NULLIF(tr.pos_avg, 0))
    * CAST(tr.trade_perf->>'lev_ratio' AS FLOAT)
    * (CAST(ob.order_metrics->>'mod_freq' AS FLOAT) / NULLIF(1 - CAST(ob.order_metrics->>'cancel_pct' AS FLOAT), 0))
  ) AS avg_ati
FROM public.manipulation_signals AS ms
JOIN public.order_behaviour AS ob ON ms."REC_TAG" = ob."REC_NODE"
JOIN public.trade_records AS tr ON ob."OST_ref" = tr."REC_KEY"
WHERE ms.layer_idx IN ('Confirmed', 'Suspected')
GROUP BY CASE WHEN ms.layer_idx = 'Confirmed' THEN 'Confirmed' ELSE 'Suspected' END
ORDER BY avg_ati DESC[0m
