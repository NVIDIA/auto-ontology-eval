    cm.budget_alloc AS budget_alloc,
    cm.budget_stat AS budget_stat,
    ROW_NUMBER() OVER (
      PARTITION BY ac."ARTregID"
      ORDER BY ca.assess_date DESC
    ) AS rn
  FROM public."ArtifactsCore" ac
  JOIN public."ConditionAssessments" ca
    ON ca.art_exam = ac."ARTregID"
  JOIN public."SurfaceAndPhysicalReadings" sp
    ON sp.surf_id = ca.light_link
  JOIN public."EnvironmentalReadingsCore" er
    ON er.monitor_code = sp.env_link
  JOIN public."ConservationAndMaintenance" cm
    ON cm.monitor_link = er.monitor_code
)
SELECT
  l.dynasty,
  (COALESCE((r.rating_profile->>'research_score')::numeric, 0)
    + COALESCE((r.rating_profile->>'cultural_score')::numeric, 0)
    + CASE
        WHEN l.conserve_status = 'Excellent' THEN 1
        WHEN l.conserve_status = 'Good' THEN 3
        WHEN l.conserve_status = 'Fair' THEN 5
        WHEN l.conserve_status = 'Poor' THEN 7
        WHEN l.conserve_status = 'Critical' THEN 10
        ELSE 0
      END) AS importance_metric,
  CASE
    WHEN l.budget_alloc IN ('Sufficient', 'Adequate') THEN 'Sufficient'
    WHEN l.budget_alloc = 'Insufficient' THEN 'Insufficient'
    ELSE 'Unknown'
  END AS budget_allocation_category,
  l.budget_stat AS current_status
FROM linked l
LEFT JOIN public."ArtifactRatings" r
  ON r."ART_link" = l.art_reg_id
WHERE l.rn = 1
ORDER BY importance_metric DESC;[0m
