),
thresholds AS (
  SELECT
    b.organ,
    PERCENTILE_CONT(0.98) WITHIN GROUP (ORDER BY b.days_waiting) AS p98
  FROM base AS b
  GROUP BY b.organ
)
SELECT
  b.patient_id,
  b.organ,
  b.days_waiting,
  b.pra_score,
  b.comorbidity_count
FROM base AS b
JOIN thresholds AS t
  ON b.organ = t.organ
