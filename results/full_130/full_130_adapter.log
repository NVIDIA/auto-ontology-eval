JOIN public.patients AS p ON ab.pat_owner_ref = p.pat_key
JOIN public.clinicians AS c ON p.clin_lead_ref = c.clin_key
JOIN public.facilities AS f ON c.fac_connect = f.fac_key
JOIN public.assessmentsocialanddiagnosis AS d ON ab.ab_key = d.asd_key
WHERE f.fac_key = 'F533'
  AND d.prim_dx = 'Anxiety'
  AND d.dx_dur_m > 12
ORDER BY yearly_side_effect_score DESC;[0m
