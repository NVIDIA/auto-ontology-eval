SELECT dp."Flow_Sign" AS flow_id, dp.vol_gb * CASE WHEN dp."dataSense" = 'High' THEN 3 ELSE 1 END AS dsi, df.flow_overview->'routing'->>'destination_country' AS destination_country
FROM public."DataProfile" AS dp
JOIN public."DataFlow" AS df ON dp."Flow_Sign" = df."RecordRegistry"
WHERE dp.vol_gb * CASE WHEN dp."dataSense" = 'High' THEN 3 ELSE 1 END > 100
ORDER BY dsi DESC

