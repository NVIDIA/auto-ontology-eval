  ┌─ [1msql:[0m [1;35mWITH gaps AS (
  SELECT i.interact_fan_pivot AS fan_id,
         EXTRACT(EPOCH FROM (i.time_mark - LAG(i.time_mark) OVER (PARTITION BY i.interact_fan_pivot ORDER BY i.time_mark))) / 86400.0 AS gap_days
  FROM public.interactions AS i
),
top_fan AS (
  SELECT g.fan_id
  FROM gaps AS g
  JOIN public.fans AS f ON g.fan_id = f.user_registry
  WHERE g.gap_days IS NOT NULL
    AND EXISTS (
      SELECT 1
      FROM public.interactions AS i2
      JOIN public.engagement AS e ON e.engage_activity_pivot = i2.activity_reg
      JOIN public.retentionandinfluence AS r ON r.retain_engage_pivot = e.engage_reg
      WHERE i2.interact_fan_pivot = f.user_registry
        AND r.churn_flag = 'High'
    )
  GROUP BY g.fan_id
  ORDER BY AVG(g.gap_days) DESC
  LIMIT 1
)
SELECT i.act_kind, COUNT(*) AS activity_count
FROM public.interactions AS i
JOIN top_fan AS t ON i.interact_fan_pivot = t.fan_id
GROUP BY i.act_kind
ORDER BY activity_count DESC
LIMIT 3;[0m
