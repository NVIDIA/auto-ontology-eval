      ) AS performance_score
FROM public.constructor_results AS cr
JOIN public.constructors AS c ON cr.unitnode = c.cstr_key
JOIN public.races AS r ON cr.matchref = r.rak_id
WHERE c.namelabel = 'McLaren'
ORDER BY performance_score DESC[0m
