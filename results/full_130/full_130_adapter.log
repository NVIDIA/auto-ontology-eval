  ┌─ [1msql:[0m [1;35mSELECT string_agg('Order ' || o."ORD_STAMP" || ': ' || (((o.order_attributes->>'quantity')::numeric - x.remain_amt) / NULLIF((o.order_attributes->>'quantity')::numeric, 0) * 100)::text || '%', '; ' ORDER BY ((o.order_attributes->>'quantity')::numeric - x.remain_amt) / NULLIF((o.order_attributes->>'quantity')::numeric, 0) * 100 DESC) AS fill_rates
