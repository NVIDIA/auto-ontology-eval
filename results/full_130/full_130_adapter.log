  ┌─ [1msql:[0m [1;35mSELECT f.nick_label AS nickname,
       m.spend_usd AS total_spending,
       (i.live_att * 1.5) AS event_participation_score,
       l.rew_tier AS loyalty_tier_level
FROM public.membershipandspending AS m
JOIN public.fans AS f ON m.member_fan_pivot = f.user_registry
JOIN public.interactions AS i ON m.member_fan_pivot = i.interact_fan_pivot
JOIN public.loyaltyandachievements AS l ON m.member_reg = l.loyalty_engage_pivot
WHERE i.sess_dur_min > 0
  AND (m.spend_usd / i.sess_dur_min) > (
      SELECT AVG(m2.spend_usd / i2.sess_dur_min)
      FROM public.membershipandspending AS m2
      JOIN public.interactions AS i2 ON m2.member_fan_pivot = i2.interact_fan_pivot
      WHERE i2.sess_dur_min > 0
  )
  AND (i.live_att * 1.5) > (
      SELECT AVG(i3.live_att * 1.5)
      FROM public.interactions AS i3
  )
ORDER BY (m.spend_usd / i.sess_dur_min) DESC;[0m
