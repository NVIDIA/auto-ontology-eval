  ┌─ [1msql:[0m [1;35mSELECT d.distregistry,
       d.affectedarea,
       (0.6 * ((10 * COALESCE(d.impact_summary->'population_impact'->>'casualties', '0')::int)
              + (3 * COALESCE(d.impact_summary->'population_impact'->>'injured', '0')::int)
              + (2 * COALESCE(d.impact_summary->'population_impact'->>'missing', '0')::int)
              + (1 * COALESCE(d.impact_summary->'population_impact'->>'displaced', '0')::int)))
       + (0.4 * ((COALESCE(d.impact_summary->'infrastructure_damage'->>'infra_damage_pct', '0')::numeric)
              + (COALESCE(d.impact_summary->'infrastructure_damage'->>'power_outage_pct', '0')::numeric)
              + (COALESCE(d.impact_summary->'infrastructure_damage'->>'water_damage_pct', '0')::numeric)) / 3) AS dsi
FROM public.disasterevents AS d
