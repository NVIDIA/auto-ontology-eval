  ┌─ [1msql:[0m [1;35mSELECT p.pat_key,
       ab.med_side_eff_density,
       CAST(SPLIT_PART(ab.med_side_eff_density, ' ', 1) AS FLOAT) * 2 * 12 AS yearly_side_effect_score,
       CASE WHEN CAST(SPLIT_PART(ab.med_side_eff_density, ' ', 1) AS FLOAT) * 2 * 12 > 3.0 THEN 'Over Safety Limit' ELSE 'Within Safety Limit' END AS safety_limit_flag
