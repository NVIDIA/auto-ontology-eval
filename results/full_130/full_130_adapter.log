  ┌─ [1msql:[0m [1;35mSELECT
  tm.donor_ref_reg AS donor_id,
  tm.recip_ref_reg AS patient_id,
  CASE
    WHEN (ABS(rd.age_count - (SPLIT_PART(d.age_count, ' ', 1))::numeric) > 25)
      AND (((SPLIT_PART(fr.don_gfr_val, ' ', 1))::numeric - 10.0 * (SPLIT_PART(fr.don_crtn_val, ' ', 1))::numeric) < 40)
      THEN 'Age difference exceeds 25 years AND Renal Function Score below 40'
    WHEN ABS(rd.age_count - (SPLIT_PART(d.age_count, ' ', 1))::numeric) > 25
      THEN 'Age difference exceeds 25 years'
    ELSE 'Renal Function Score below 40'
  END AS marginal_reason,
  0.7 * (CASE
           WHEN c.med_urgency = 'Status 1A' THEN 5
           WHEN c.med_urgency = 'Status 1B' THEN 4
           WHEN c.med_urgency = 'Status 2' THEN 3
           WHEN c.med_urgency = 'Status 3' THEN 2
           ELSE 1
         END)
  + 0.3 * ((SPLIT_PART(c.wait_time, ' ', 1))::numeric / 365.0) AS patient_urgency_score
FROM public.transplant_matching AS tm
JOIN public.clinical AS c
  ON tm.recip_ref_reg = c.clin_recip_registry
JOIN public.recipients_demographics AS rd
  ON c.clin_recip_registry = rd.recip_registry
JOIN public.demographics AS d
  ON tm.donor_ref_reg = d.contrib_registry
JOIN public.function_and_recovery AS fr
  ON tm.donor_ref_reg = fr.recov_don_registry
WHERE ABS(rd.age_count - (SPLIT_PART(d.age_count, ' ', 1))::numeric) > 25
   OR (((SPLIT_PART(fr.don_gfr_val, ' ', 1))::numeric - 10.0 * (SPLIT_PART(fr.don_crtn_val, ' ', 1))::numeric) < 40)
ORDER BY patient_urgency_score DESC[0m
