       CAST(ci.mediacounts->'content_volumes'->>'Videos_Total' AS numeric) AS total_video_count,
       CASE
         WHEN CAST(ci.mediacounts->'content_volumes'->>'Videos_Total' AS numeric) > 500 THEN 'High'
         WHEN CAST(ci.mediacounts->'content_volumes'->>'Videos_Total' AS numeric) BETWEEN 200 AND 500 THEN 'Medium'
         ELSE 'Low'
       END AS content_size_classification,
       CASE
         WHEN CAST(ci.mediacounts->'content_volumes'->>'Videos_Total' AS numeric) > 500
              AND CAST(ci.mediacounts->'content_volumes'->>'Videos_Total' AS numeric) >= 1000 THEN true
         ELSE false
       END AS large_scale_show
FROM public.content_info AS ci
WHERE ci.mediacounts->'content_volumes'->>'Videos_Total' IS NOT NULL
ORDER BY total_video_count DESC[0m
