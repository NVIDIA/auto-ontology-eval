SELECT ROUND((COUNT(CASE WHEN cr.scoreval IS NOT NULL THEN 1 END)::numeric / COUNT(cr.matchref)::numeric) * 100, 2) AS finishing_record_percentage
FROM public.constructor_results AS cr
GROUP BY cr.unitnode
HAVING COUNT(cr.matchref) >= 5
ORDER BY (COUNT(CASE WHEN cr.scoreval IS NOT NULL THEN 1 END)::numeric / COUNT(cr.matchref)::numeric) * 100 DESC
LIMIT 1

