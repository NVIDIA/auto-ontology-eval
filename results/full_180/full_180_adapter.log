  ┌─ [1msql:[0m [1;35mSELECT COUNT(*) AS underperforming_high_cost_plant_count
FROM public.electrical_performance AS ep
JOIN public.environmental_conditions AS ec ON ec.snapref = ep.snaplink
JOIN public.operational_metrics AS om ON om.snapops = ep.snaplink
JOIN public.plant_record AS pr ON pr.snapkey = ep.snaplink
JOIN public.plants AS pl ON pl.sitekey = pr.sitetie
WHERE (ep.elec_perf_snapshot->'energy_yield'->>'specific_yield_kwh_kw') IS NOT NULL
  AND (ec.env_snapshot->'irradiance'->>'poa_irr_w_m2') IS NOT NULL
  AND (ec.env_snapshot->'irradiance'->>'poa_irr_w_m2')::numeric > 0
  AND (ep.elec_perf_snapshot->'energy_yield'->>'specific_yield_kwh_kw')::numeric
      / ((ec.env_snapshot->'irradiance'->>'poa_irr_w_m2')::numeric / 1000) < 0.75
  AND pl.cap_mw > 0
  AND (om.maintcost + om.cleancost + om.replcost) / pl.cap_mw > 10;[0m
