total number of returns in return_channel = count of returns grouped by return_channel  
return_channel = return_channel column in public.returns  
valid warranty claim condition = return_details->'authorization'->>'warranty_claim' IS NOT NULL AND return_details->'authorization'->>'warranty_claim' <> ''
