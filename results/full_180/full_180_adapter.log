  ┌─ [1msql:[0m [1;35mSELECT ab.pat_owner_ref AS patient_id,
       CAST(SPLIT_PART(ab.med_side_eff_density, ' ', 1) AS FLOAT) AS med_side_effect_density,
       CAST(SPLIT_PART(ab.med_side_eff_density, ' ', 1) AS FLOAT) * 2 * 12 AS annualized_side_effect_score,
       CASE WHEN CAST(SPLIT_PART(ab.med_side_eff_density, ' ', 1) AS FLOAT) * 2 * 12 > 0.1 THEN TRUE ELSE FALSE END AS score_flag
FROM public.assessmentbasics AS ab
JOIN public.patients AS p ON ab.pat_owner_ref = p.pat_key
JOIN public.clinicians AS c ON p.clin_lead_ref = c.clin_key
