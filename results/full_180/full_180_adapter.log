FROM public.system_controller AS sc
JOIN public.mechanical_status AS ms ON sc.systemoverseeractuation = ms.mechactref
JOIN public.robot_details AS rd ON ms.mechdetref = rd.botdetreg
JOIN public.joint_condition AS jc ON rd.botdetreg = jc.jcdetref
JOIN (
    SELECT rd2.bottypeval AS bottypeval,
           AVG((sc2.overseerloadvalue + sc2.memuseval) / 2) AS avg_stress
    FROM public.system_controller AS sc2
    JOIN public.mechanical_status AS ms2 ON sc2.systemoverseeractuation = ms2.mechactref
    JOIN public.robot_details AS rd2 ON ms2.mechdetref = rd2.botdetreg
    GROUP BY rd2.bottypeval
) AS avg_by_model ON rd.bottypeval = avg_by_model.bottypeval
WHERE (sc.overseerloadvalue + sc.memuseval) / 2 > 1.2 * avg_by_model.avg_stress
ORDER BY controller_stress DESC[0m
