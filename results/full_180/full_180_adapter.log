       p.pat_age,
       a.last_hosp_dt,
       e.nx_appt_dt
FROM public.treatmentbasics AS t
JOIN public.encounters AS e ON t.enc_ref = e.enc_key
JOIN public.patients AS p ON e.pat_ref = p.pat_key
JOIN public.assessmentbasics AS ab ON e.ab_ref = ab.ab_key
JOIN public.assessmentsocialanddiagnosis AS a ON a.asd_key = ab.ab_key
WHERE t.crisis_int > 2
  AND ((CASE a.funcassess->>'Soc_Sup'
          WHEN 'Strong' THEN 3
          WHEN 'Adequate' THEN 2
          WHEN 'Limited' THEN 1
          WHEN 'Weak' THEN 0
          ELSE 0 END)
     + (CASE a.funcassess->>'Rel_Qual'
          WHEN 'Good' THEN 3
          WHEN 'Fair' THEN 2
          WHEN 'Poor' THEN 1
          WHEN 'Conflicted' THEN 0
          ELSE 0 END)) / 2.0 < 3
ORDER BY t.crisis_int DESC[0m
