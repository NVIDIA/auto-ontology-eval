SELECT ROUND(AVG(
  0.4 * (((CAST(et.type_indices->>'performance_score' AS numeric) + e."RELIAB_IDX") / 2)
         * (1 - CAST(et.type_indices->>'environmental_impact_idx' AS numeric) / 100))
  + 0.4 * (CASE
             WHEN om."OPER_status" = 'Active' THEN 10 * (1 - om."OPER_hours" / NULLIF(om."maintCycleHrs", 0))
             WHEN om."OPER_status" = 'Standby' THEN 5 * (1 - om."OPER_hours" / NULLIF(om."maintCycleHrs", 0))
             ELSE 0
           END)
  + 0.2 * ((CASE
              WHEN c.antenna_stat = 'Error' THEN 0
              WHEN c.antenna_stat = 'Warning' THEN 5
              WHEN c.antenna_stat = 'Normal' THEN 10
              ELSE 0
            END) * (1 - c."netLatency_ms" / 1000))
)::numeric, 2) AS overall_reliability_metric
FROM public."OperationMaintenance" AS om
JOIN public."Communication" AS c ON om."equipRef" = c."equipRef"
JOIN public."Equipment" AS e ON om."equipRef" = e."EQUIP_CODE"
JOIN public."EquipmentType" AS et ON e."EquipType" = et."EquipType"
WHERE om."OPER_status" = 'Active'

