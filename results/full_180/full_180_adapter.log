SELECT a."art_title", a."DYNASTY", s."env_handling_sensitivity"->'environment'->>'light' AS light_sensitivity_rating, l."lux", l."visLxh"
FROM public."SensitivityData" s
JOIN public."ArtifactsCore" a ON s."ART_link" = a."ARTregID"
JOIN public."ConditionAssessments" c ON c."art_exam" = a."ARTregID"
