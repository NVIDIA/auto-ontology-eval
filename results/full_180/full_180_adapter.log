[Phase 1 SQL reference — use exact column names, thresholds, and formulas from this SQL where applicable]
SELECT
  CASE
    WHEN vri < 2 THEN 'High Risk'
    WHEN vri >= 2 AND vri < 3 THEN 'Medium Risk'
    ELSE 'Low Risk'
  END AS risk_level,
  COUNT(*) AS vendor_count,
  ROUND(COUNT(*)::numeric * 100 / SUM(COUNT(*)) OVER (), 2) AS proportion_pct
FROM (
  SELECT
    (CASE "vendSecRate"
       WHEN 'A' THEN 4
       WHEN 'B' THEN 3
       WHEN 'C' THEN 2
       WHEN 'D' THEN 1
       ELSE 0
     END) *
    (CASE WHEN "contrState" = 'Active' THEN 1.0 ELSE 0.5 END) AS vri
  FROM public."VendorManagement"
) AS t
GROUP BY
  CASE
    WHEN vri < 2 THEN 'High Risk'
    WHEN vri >= 2 AND vri < 3 THEN 'Medium Risk'
    ELSE 'Low Risk'
  END
ORDER BY vendor_count DESC;

