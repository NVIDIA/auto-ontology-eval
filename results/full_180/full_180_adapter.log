01:42:32 INFO [turn 4 | 53.0s] DECISION: SUBMIT SQL  (history len=3/7)
  ┌─ [1msql:[0m [1;35mSELECT ad.actrecref AS robot_id,
       op.apptypeval AS precision_work_application,
       ad.poserrmmval / rd.reachmmval AS relative_positional_error,
       CASE
         WHEN TRIM(ps.calibstateval) = 'Y' THEN 'Success'
         WHEN TRIM(ps.calibstateval) = '0' THEN 'Failed'
         WHEN TRIM(ps.calibstateval) = 'N' THEN 'Pending'
         ELSE 'Unknown'
       END AS calibration_status
FROM public.actuation_data AS ad
JOIN public.operation AS op ON ad.actoperref = op.operreg
JOIN public.robot_details AS rd ON ad.actrecref = rd.botdetreg
LEFT JOIN public.performance_and_safety AS ps ON rd.botdetreg = ps.effectivenessrobot
WHERE op.apptypeval IN ('Assembly', 'Electronics-Handling', 'Inspection', 'Dispensing', 'Laser Cutting')
