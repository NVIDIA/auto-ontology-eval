  ┌─ [1msql:[0m [1;35mSELECT f.nick_label AS nickname,
       (r.infl_impact->>'Viral_Cont')::numeric * (1 + (r.infl_impact->>'Trend_Part')::numeric) AS viral_score,
       SQRT((s.network_stats->>'Foll_Count')::numeric * (r.infl_impact->>'Cont_Reach')::numeric) AS community_influence
FROM public.retentionandinfluence AS r
JOIN public.engagement AS e ON r.retain_engage_pivot = e.engage_reg
JOIN public.membershipandspending AS m ON e.engage_member_pivot = m.member_reg
JOIN public.fans AS f ON m.member_fan_pivot = f.user_registry
JOIN public.loyaltyandachievements AS l ON r.retain_loyalty_pivot = l.loyalty_reg
JOIN public.eventsandclub AS ev ON l.loyalty_events_pivot = ev.events_reg
