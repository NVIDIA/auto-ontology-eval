  raw: From our collection of artifacts, identify the artifacts that rank in the top 10% tier by either historical significance or cultural score, using the NTILE(10) window function on the "HIST_sign" column (descending) and the "cultural_score" from the rating_profile JSONB field (descending), respectively (i.e., artifacts where NTILE = 1 for either metric). From these most valuable artifacts, for each dynasty, find the single artifact that has the highest insurance value. Display the dynasty, the artifact's title, and its insurance value.

[Phase 1 SQL reference — use exact column names, thresholds, and formulas from this SQL where applicable]
WITH scored AS (
  SELECT
    ac."DYNASTY" AS dynasty,
    (ar.rating_profile->>'cultural_score')::numeric AS cultural_score,
    NTILE(10) OVER (ORDER BY ar."HIST_sign" DESC) AS ntile_hist,
    NTILE(10) OVER (ORDER BY (ar.rating_profile->>'cultural_score')::numeric DESC) AS ntile_cult
  FROM public."ArtifactsCore" ac
  JOIN public."ArtifactRatings" ar ON ac."ARTregID" = ar."ART_link"
)
SELECT
  dynasty,
  COUNT(*) AS count_most_valuable,
  AVG(cultural_score) AS avg_cultural_value
FROM scored
WHERE ntile_hist = 1 OR ntile_cult = 1
GROUP BY dynasty
ORDER BY count_most_valuable DESC;

Evidence: HIST_sign_top10 = NTILE(10) OVER (ORDER BY HIST_sign DESC) = 1  
cultural_score_top10 = NTILE(10) OVER (ORDER BY (rating_profile->>'cultural_score')::numeric DESC) = 1  
insurance_value_threshold = insurance_value > 1000000
