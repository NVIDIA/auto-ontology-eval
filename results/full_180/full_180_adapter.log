[Phase 1 SQL reference — use exact column names, thresholds, and formulas from this SQL where applicable]
SELECT m."exchNote",
       m."TimeTrack",
       (((m.orderbook_metrics->>'best_ask')::numeric - (m.orderbook_metrics->>'best_bid')::numeric)
         / (((m.orderbook_metrics->>'best_ask')::numeric + (m.orderbook_metrics->>'best_bid')::numeric) / 2)) * 100 AS spread_percentage
FROM public.marketdata AS m
ORDER BY m."TimeTrack" DESC
LIMIT 1

