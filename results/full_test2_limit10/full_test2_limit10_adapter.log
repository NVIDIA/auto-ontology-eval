  SELECT (o2.order_attributes->>'quantity')::numeric
    * (o2.order_attributes->>'limit_price')::numeric
    * COALESCE((a2.indicator_bundle->'order_flow'->>'large_order_ratio')::numeric, 0)
    * 0.01
  FROM public.orders o2
  LEFT JOIN public.analyticsindicators a2 ON o2."exchSpot" = a2.md_ref
  WHERE o2."ORD_STAMP" = 'OR6015391'
)
ORDER BY market_impact_cost_mic DESC;[0m
