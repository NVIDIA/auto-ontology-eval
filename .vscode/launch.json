{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--database-name",
        "wideworldimporters"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local WWI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_wwi.py",
      "args": [
        "--database-name",
        "wideworldimporters",
        "--drop",
        "--refresh-collation"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local BIRD",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_bird.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local FDABench",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_fdabench.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local BEAVER",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_beaverbench.py",
      "args": [
        "--import-mysql"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Judge (score CSVs)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.judge.main",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.ingest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Semantic compile",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.semantic",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Benchmark (BIRD, 1 question)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--database-name",
        "bird",
        "--skip-ingest",
        "--skip-semantic",
        "--limit",
        "1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
