{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Judge (score CSVs)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.judge.main",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.pipeline",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Semantic compile",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.semantic",
      "args": [
        "--database-name",
        "${input:databaseName}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_chatbot",
      "args": [
        "--database-name",
        "${input:databaseName}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_chatbot",
      "args": [
        "--single",
        "--database-name",
        "${input:databaseName}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "databaseName",
      "type": "pickString",
      "description": "Database name",
      "options": [
        "wideworldimporters",
        "bird"
      ],
      "default": "wideworldimporters"
    }
  ]
}
