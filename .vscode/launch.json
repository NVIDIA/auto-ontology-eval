{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--database-name",
        "wideworldimporters"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Seed local WWI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_wwi.py",
      "args": [
        "--database-name",
        "wideworldimporters",
        "--drop",
        "--refresh-collation"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local BIRD (Mini-Dev)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_bird.py",
      "args": [
        "--splits",
        "mini-dev"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local BIRD (Dev + Train)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_bird.py",
      "args": [
        "--splits",
        "dev",
        "train"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Judge (score CSVs)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.judge.main",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Judge BIRD (EX + VES)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.judge.bird",
      "args": [
        "--input",
        "input/bird_gpt-5.5.csv",
        "--dataset-name",
        "bird",
        "--skip-ves"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false
    },
    {
      "name": "Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.ingest",
      "args": [
        "--dataset-name",
        "bird"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Semantic compile",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.semantic",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval (parallel)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_parallel_eval.py",
      "args": [
        "--database-name",
        "bird",
        "--chunk-size",
        "100"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_chatbot",
      "args": [
        "--database-name",
        "bird"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_chatbot",
      "args": [
        "--single",
        "--database-name",
        "wideworldimporters"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    }
  ]
}
