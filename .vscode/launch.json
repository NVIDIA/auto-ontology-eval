{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--database-name",
        "amazon"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Seed local WWI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_wwi.py",
      "args": [
        "--database-name",
        "amazon",
        "--drop",
        "--refresh-collation"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Seed local BIRD",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_bird.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Judge (score CSVs)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.judge.main",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Judge BIRD (EX + VES)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.judge.bird",
      "args": [
        "--input",
        "input/bird_nemotron-3-nano-30b-a3b.csv",
        "--skip-ves"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false
    },
    {
      "name": "Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.ingest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Semantic compile",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.ingestion.semantic",
      "args": [
        "--database-name",
        "amazon"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_chatbot",
      "args": [
        "--single",
        "--database-name",
        "amazon"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval rerank",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_rerank",
      "args": [
        "--database-name",
        "amazon"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    },
    {
      "name": "Eval rerank (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "ontology_sql_eval.retrieval.eval_rerank",
      "args": [
        "--single",
        "--database-name",
        "amazon"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../GSF"
      },
      "justMyCode": false
    }
  ]
}
