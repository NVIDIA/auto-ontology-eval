Fix: compare rounded numbers as Decimal so float vs numeric is not a fail.
See tests/bird_interact/test_numeric_type_compare.py.
psycopg2 returns numeric as Decimal and float4/float8 as float; Python's
Decimal('0.01') != 0.01 even when both round to the same 2 decimal places.
Applied automatically by scripts/start_bird_services.sh — safe to re-run.

--- a/shared/db_utils.py
+++ b/shared/db_utils.py
@@ -180,17 +180,29 @@
 
 
 def process_decimals_recursive(item, decimal_places: int):
+    """Round numbers to *decimal_places*, coercing int/float/Decimal to Decimal.
+
+    psycopg2 returns numeric as Decimal and float4/float8 as float. Python's
+    ``Decimal('0.01') != 0.01``, so a semantically equal pred/gold pair was
+    rejected. One type after rounding fixes that without rewriting SQL.
+    bool is a subclass of int and must stay bool.
+    """
     quantizer = Decimal(1).scaleb(-decimal_places)
+    if isinstance(item, bool):
+        return item
     if isinstance(item, Decimal):
         return item.quantize(quantizer, rounding=ROUND_HALF_UP)
-    elif isinstance(item, float):
-        return round(item, decimal_places)
-    elif isinstance(item, (list, tuple)):
+    if isinstance(item, float):
+        return Decimal(str(item)).quantize(quantizer, rounding=ROUND_HALF_UP)
+    if isinstance(item, int):
+        return Decimal(item).quantize(quantizer, rounding=ROUND_HALF_UP)
+    if isinstance(item, (list, tuple)):
         return type(item)(process_decimals_recursive(x, decimal_places) for x in item)
-    elif isinstance(item, dict):
+    if isinstance(item, dict):
         return {k: process_decimals_recursive(v, decimal_places) for k, v in item.items()}
     return item
 
+
 def preprocess_results(results, decimal_places: int = 2):
     if results is None:
         return []
