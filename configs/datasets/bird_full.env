# Dataset config for scripts/provision_catalog.sh -- run as:
#   scripts/provision_catalog.sh bird_full
#
# The 22 BIRD-Interact Full task DBs. Isolated from bird_lite in its own
# catalog database -- see bird_lite.env's comment for why.
#
# Assumes third_party/BIRD-Interact/env's Full Postgres compose is already up
# on :5433 (container bird_interact_postgresql_full) -- SEED_CMD below brings
# that up if it isn't. Uses the non-template DB names (the `_template` ones
# are source templates for ADK's per-task-id resets, not queryable catalogs).

POSTGRES_DATABASE=gsf_bird_full

CONNECTION_STRINGS=postgresql://root:123123@localhost:5433/mental_health,postgresql://root:123123@localhost:5433/labor_certification_applications,postgresql://root:123123@localhost:5433/hulushows,postgresql://root:123123@localhost:5433/archeology_scan,postgresql://root:123123@localhost:5433/cold_chain_pharma_compliance,postgresql://root:123123@localhost:5433/cross_border,postgresql://root:123123@localhost:5433/crypto_exchange,postgresql://root:123123@localhost:5433/cybermarket_pattern,postgresql://root:123123@localhost:5433/disaster_relief,postgresql://root:123123@localhost:5433/exchange_traded_funds,postgresql://root:123123@localhost:5433/fake_account,postgresql://root:123123@localhost:5433/households,postgresql://root:123123@localhost:5433/insider_trading,postgresql://root:123123@localhost:5433/museum_artifact,postgresql://root:123123@localhost:5433/organ_transplant,postgresql://root:123123@localhost:5433/planets_data,postgresql://root:123123@localhost:5433/polar_equipment,postgresql://root:123123@localhost:5433/reverse_logistics,postgresql://root:123123@localhost:5433/robot_fault_prediction,postgresql://root:123123@localhost:5433/solar_panel,postgresql://root:123123@localhost:5433/sports_events,postgresql://root:123123@localhost:5433/virtual_idol

SEED_CMD="uv run python scripts/seed_bird_interact.py --dataset full"
