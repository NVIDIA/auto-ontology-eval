# Dataset config for scripts/provision_catalog.sh -- run as:
#   scripts/provision_catalog.sh spider2_lite
#
# Spider2-lite's SQLite DBs, seeded by scripts/seed_spider2_sqlite.py into
# datasets/spider2/<slug>/<slug>.sqlite (one dir per DB; some dirs there are
# non-SQLite dialects from the wider Spider2-lite set and are skipped by the
# CONNECTION_STRINGS_CMD glob below, not by any per-dialect config here).
#
# CONNECTION_STRINGS_CMD (not a literal CONNECTION_STRINGS) because this
# dataset's DB list is a moving set of local files, not a fixed enumerated
# list of remote DBs the way bird_lite/bird_full are -- discovering it from
# disk means this file never needs editing when seed_spider2_sqlite.py adds
# or removes a DB.

POSTGRES_DATABASE=gsf_spider2_lite

CONNECTION_STRINGS_CMD='find "$(pwd)/datasets/spider2" -maxdepth 2 -name "*.sqlite" | sort | sed "s#^#sqlite:///#" | paste -sd, -'

SEED_CMD="uv run python scripts/seed_spider2_sqlite.py"
