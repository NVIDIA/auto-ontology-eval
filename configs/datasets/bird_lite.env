# Dataset config for scripts/provision_catalog.sh -- run as:
#   scripts/provision_catalog.sh bird_lite
#
# The 18 BIRD-Interact Lite task DBs. Isolated from bird_full in its own
# catalog database (see ontology-sql-eval's harbor-bird-interact-integration
# -decisions notes on why: GSF's semantic layer shares `term` rows globally
# within one Postgres database, so a shared catalog would let Lite and Full
# cross-link business terms even though their source DB names don't collide).
#
# Assumes third_party/BIRD-Interact/env's Lite Postgres compose is already up
# on :5434 (container bird_interact_postgresql) -- SEED_CMD below brings that
# up if it isn't.

POSTGRES_DATABASE=gsf_bird_lite

CONNECTION_STRINGS=postgresql://root:123123@localhost:5434/alien,postgresql://root:123123@localhost:5434/archeology,postgresql://root:123123@localhost:5434/credit,postgresql://root:123123@localhost:5434/cross_db,postgresql://root:123123@localhost:5434/crypto,postgresql://root:123123@localhost:5434/cybermarket,postgresql://root:123123@localhost:5434/disaster,postgresql://root:123123@localhost:5434/fake,postgresql://root:123123@localhost:5434/gaming,postgresql://root:123123@localhost:5434/insider,postgresql://root:123123@localhost:5434/mental,postgresql://root:123123@localhost:5434/museum,postgresql://root:123123@localhost:5434/news,postgresql://root:123123@localhost:5434/polar,postgresql://root:123123@localhost:5434/robot,postgresql://root:123123@localhost:5434/solar,postgresql://root:123123@localhost:5434/vaccine,postgresql://root:123123@localhost:5434/virtual

SEED_CMD="uv run python scripts/seed_bird_interact.py --dataset lite"
