# Secrets / local environment
.env
third_party/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Judge working I/O dirs — keep the folders, ignore their contents
/input/*
/output/*
!/input/.gitkeep
!/output/.gitkeep

# OS / editor
.DS_Store

# Datasets kept local only (not tracked on remote) — keep the folders, ignore their contents
/datasets/bird/*
/datasets/bird_interact/*
/datasets/bird_interact_full/*
/datasets/dor_prod/
!/datasets/bird/.gitkeep
!/datasets/bird/README.md
!/datasets/bird_interact/.gitkeep
!/datasets/bird_interact/gt/
/datasets/bird_interact/gt/*
!/datasets/bird_interact/gt/.gitkeep

# Test-run outputs (transient, local only) — keep the curated
# flagged_questions notes tracked, ignore everything else under results/
/results/*
!/results/flagged_questions_full.txt
!/results/flagged_questions_lite.txt
