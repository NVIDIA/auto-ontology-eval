# Secrets / local environment
.env
# Backups made while swapping keys between runs hold live credentials
# just as the real file does, and are easy to `git add -A` by accident.
.env.*
third_party/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Judge working I/O dirs — keep the folders, ignore their contents
/input/*
/output/*
!/input/.gitkeep
!/output/.gitkeep

# Per-run eval instrumentation bundles — keep the folder, ignore the runs
/logs/*
!/logs/.gitkeep

# OS / editor
.DS_Store

# Datasets kept local only (not tracked on remote) — keep the folders, ignore their contents
/datasets/bird/*
/datasets/bird_interact/*
/datasets/bird_interact_full/*
/datasets/fdabench/*
/datasets/dor_prod/
!/datasets/bird/.gitkeep
!/datasets/bird/README.md
!/datasets/bird_interact/.gitkeep
!/datasets/bird_interact/gt/
/datasets/bird_interact/gt/*
!/datasets/bird_interact/gt/.gitkeep
!/datasets/fdabench/.gitkeep
!/datasets/fdabench/README.md

# Test-run outputs (transient, local only), including the flagged_questions
# notes — not tracked on remote, kept local only.
/results/*

# Cursor / Claude Code local agent-plan and session state — machine-specific, never commit.
.cursor/
.claude/projects/

# NeMo Gym: generated artifacts, not sources.
# Task JSONL is rebuilt deterministically by scripts/build_gym_tasks.py and
# embeds full schema dumps, so it is large and regenerable.
# Full task splits are regenerable by scripts/build_gym_tasks.py and embed whole
# schema dumps. Following NeMo Gym's own convention (see any bundled server's
# data/.gitignore), the full splits are ignored but a 5-row example.jsonl is
# committed -- `gym env test` requires one.
resources_servers/*/data/*
!resources_servers/*/data/example.jsonl
!resources_servers/*/data/example_metrics.json
!resources_servers/*/data/example_rollouts.jsonl
# Rollouts, aggregate metrics and materialized inputs from `gym eval run`.
runs/
# bird60 is a locally-built BIRD subset; see scripts/build_gym_tasks.py --limit
# and datasets/bird60/build_bird60.py on branch benchmark-results-run4-run5.
datasets/bird60/
