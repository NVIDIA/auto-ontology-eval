# Secrets / local environment
.env
third_party/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Judge working I/O dirs — keep the folders, ignore their contents
/input/*
/output/*
!/input/.gitkeep
!/output/.gitkeep

# OS / editor
.DS_Store

# Datasets kept local only (not tracked on remote) — keep the folders, ignore their contents
/datasets/bird/*
/datasets/dor_prod/
!/datasets/bird/.gitkeep
!/datasets/bird/README.md

# Spider2 local SQLite databases (large, not tracked)
/datasets/spider2/
