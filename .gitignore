# Secrets / local environment
.env
# Backups made while swapping keys between runs hold live credentials
# just as the real file does, and are easy to `git add -A` by accident.
.env.*
third_party/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
# Gym 0.7+ serializes server venv setup with a lock file beside each .venv.
.venv.setup.lock

# Scratch output of the extra-prompt scripts — keep the folder, ignore its contents
/output/*
!/output/.gitkeep

# Extra prompts are tracked; the LLM response caches written beside them
# (including the timestamped copies a rebuild archives) are not.
/inputs/extra_prompts/**/*_cache*.jsonl

# Downloaded by scripts/migrate_catalog.py, and Gym's uv cache
/cache/

# Working area: cloned sources read for comparison, and the extraction drafts
# build_graph.py --cache-draft writes. Both are regenerable and large, and a
# cached draft is a snapshot of one prompt's output -- committing it would
# invite a reader to treat it as the current behaviour.
/.scratch/

# OS / editor
.DS_Store

# The old location of inputs/extra_prompts/. Git moves the tracked CSVs, but
# not the untracked LLM response caches written beside them.
/prompt_inputs/

# Datasets kept local only (not tracked on remote) — keep the folders, ignore their contents
/datasets/bird/*
/datasets/bird_interact/*
/datasets/bird_interact_full/*
/datasets/fdabench/*
/datasets/beaverbench/*
/datasets/dor_prod/
!/datasets/bird/.gitkeep
!/datasets/bird/README.md
!/datasets/bird_interact/.gitkeep
!/datasets/bird_interact/gt/
/datasets/bird_interact/gt/*
!/datasets/bird_interact/gt/.gitkeep
!/datasets/fdabench/.gitkeep
!/datasets/fdabench/README.md
!/datasets/beaverbench/.gitkeep
!/datasets/beaverbench/README.md

# Test-run outputs (transient, local only), including the flagged_questions
# notes — not tracked on remote, kept local only.
/results/*

# Cursor / Claude Code local agent-plan and session state — machine-specific, never commit.
.cursor/
.claude/projects/

# NeMo Gym: generated artifacts, not sources.
# Task JSONL is rebuilt deterministically by scripts/build_gym_tasks.py and
# embeds full schema dumps, so it is large and regenerable.
# Full task splits are regenerable by scripts/build_gym_tasks.py and embed whole
# schema dumps. Following NeMo Gym's own convention (see any bundled server's
# data/.gitignore), the full splits are ignored but a 5-row example.jsonl is
# committed -- `gym env test` requires one.
resources_servers/*/data/*
!resources_servers/*/data/example.jsonl
!resources_servers/*/data/example_metrics.json
!resources_servers/*/data/example_rollouts.jsonl
# Rollouts, aggregate metrics and materialized inputs from `gym eval run`.
runs/
# Hydra's default per-run dir. Holds only the resolved config snapshot, which
# records every override verbatim -- including policy_api_key.
outputs/

# Benchmark corpora, fetched by conversation/beam_benchmark/download_data.py.
# Regenerable from the Hugging Face Hub and large -- 13 MB for the smallest
# scale and 344 MB for the largest -- so the download script is the thing
# worth reviewing, not its output.
/conversation/data/

# Run output: rollouts, scores and reports from the BEAM arms. Regenerable,
# and a results file committed by hand is a result nobody can reproduce. The
# directory itself is kept so a run has somewhere to land.
/conversation/beam_benchmark/results/*
!/conversation/beam_benchmark/results/.gitkeep
