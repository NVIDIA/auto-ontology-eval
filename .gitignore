# Virtual environments
.venv/
venv/

# Judge working I/O dirs — keep the folders, ignore their contents
/input/*
/output/*
!/input/.gitkeep
!/output/.gitkeep

# OS / editor
.DS_Store

# Datasets kept local only (not tracked on remote) — keep the folders, ignore their contents
/datasets/bird/*
/datasets/fdabench/*
/datasets/dor_prod
!/datasets/bird/.gitkeep
!/datasets/bird/README.md
!/datasets/fdabench/.gitkeep
!/datasets/fdabench/README.md
