# Secrets / local environment
.env
# Backups made while swapping keys between runs hold live credentials
# just as the real file does, and are easy to `git add -A` by accident.
.env.*
third_party/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments. The bare form matters: this worktree's .venv is a
# symlink to the main checkout's, and `.venv/` alone does not match a symlink.
.venv
.venv/
venv/

# Judge working I/O dirs — keep the folders, ignore their contents
/input/*
/output/*
!/input/.gitkeep
!/output/.gitkeep

# Per-run eval instrumentation bundles — keep the folder, ignore the runs
/logs/*
!/logs/.gitkeep

# Eval prompt inputs are tracked; the LLM response caches written beside them
# (including the timestamped copies a rebuild archives) are not.
/prompt_inputs/**/*_cache*.jsonl

# OS / editor
.DS_Store

# Datasets kept local only (not tracked on remote) — keep the folders, ignore their contents
/datasets/bird/*
/datasets/bird_interact/*
/datasets/bird_interact_full/*
/datasets/fdabench/*
/datasets/beaverbench/*
/datasets/dor_prod/
!/datasets/bird/.gitkeep
!/datasets/bird/README.md
!/datasets/bird_interact/.gitkeep
!/datasets/bird_interact/gt/
/datasets/bird_interact/gt/*
!/datasets/bird_interact/gt/.gitkeep
!/datasets/fdabench/.gitkeep
!/datasets/fdabench/README.md
!/datasets/beaverbench/.gitkeep
!/datasets/beaverbench/README.md

# Test-run outputs (transient, local only), including the flagged_questions
# notes — not tracked on remote, kept local only.
/results/*

# Unstructured eval outputs. Every arm rebuilds these from the corpus, and
# answers.jsonl plus retrieval.json carry the full retrieved chunk text — 54 MB
# across the two sides. Only report.json is small, and it is derived from the
# answers, so nothing here is a source.
/unstructured/results/
/unstructured/benchmark/results/
/unstructured/chunk_first_results/
# Tagged variants of the same, one directory per arm of an A/B so a run never
# overwrites the numbers it is being compared against.
/unstructured/results-*/
/unstructured/chunk_first_results-*/
# The ontology agent's, kept while its answers are still on disk: the pipeline
# that wrote them has been removed, so nothing can regenerate or re-score them.
/unstructured/agent_results/
/unstructured/agent_results-*/

# Experiments: scratch that answers one question against the live corpus and
# prints the answer. Whatever they settle gets written down where it had
# consequences, so the script itself is not what anyone comes back to.
/unstructured/scripts/

# Cursor / Claude Code local agent-plan and session state — machine-specific, never commit.
.cursor/
.claude/projects/

# NeMo Gym: generated artifacts, not sources.
# Task JSONL is rebuilt deterministically by scripts/build_gym_tasks.py and
# embeds full schema dumps, so it is large and regenerable.
# Full task splits are regenerable by scripts/build_gym_tasks.py and embed whole
# schema dumps. Following NeMo Gym's own convention (see any bundled server's
# data/.gitignore), the full splits are ignored but a 5-row example.jsonl is
# committed -- `gym env test` requires one.
resources_servers/*/data/*
!resources_servers/*/data/example.jsonl
!resources_servers/*/data/example_metrics.json
!resources_servers/*/data/example_rollouts.jsonl
# Rollouts, aggregate metrics and materialized inputs from `gym eval run`.
runs/
