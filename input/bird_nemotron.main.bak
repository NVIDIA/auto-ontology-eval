482,128,moderate,"List the top nine districts, by descending order, from the highest to the lowest, the number of female account holders.","SELECT T2.A2, COUNT(T1.client_id) FROM client AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id WHERE T1.gender = 'F' GROUP BY T2.district_id, T2.A2 ORDER BY COUNT(T1.client_id) DESC LIMIT 9","SELECT d.A2
FROM client AS c
JOIN disp AS dp ON c.client_id = dp.client_id
JOIN district AS d ON c.district_id = d.district_id
WHERE c.gender = 'F'
GROUP BY d.district_id, d.A2
ORDER BY COUNT(c.client_id) DESC
LIMIT 9",0.6557,0,,,"A2,COUNT(T1.client_id)
