WHERE d.forename = 'Paul' AND d.surname = 'di Resta' AND r.raceId IN (853, 854)",0.1635,1,,,"""(SUM(IIF(T2.raceId = 853, T2.fastestLapSpeed, 0)) - SUM(IIF(T2.raceId = 854, T2.fastestLapSpeed, 0))) * 100 / SUM(IIF(T2.raceId = 853, T2.fastestLapSpeed, 0))""
