367,408,moderate,How many unknown power cards contain info about the triggered ability,SELECT Count(DISTINCT T1.id) FROM cards AS T1 INNER JOIN rulings AS T2 ON T1.uuid = T2.uuid WHERE (T1.power IS NULL OR T1.power = '*') AND T2.text LIKE '%triggered ability%',SELECT COUNT(*) FROM cards WHERE (power IS NULL OR power = '*') AND text LIKE '%triggered ability%',0.7206,0,,,"Count(DISTINCT T1.id)
1382
",,"['[{""COUNT(*)"":35}]']",0.0,0,25.83,
368,409,moderate,"Indicates the number of cards with pre-modern format, ruling text ""This is a triggered mana ability."" that do not have multiple faces.",SELECT COUNT(T1.id) FROM cards AS T1 INNER JOIN legalities AS T2 ON T1.uuid = T2.uuid INNER JOIN rulings AS T3 ON T1.uuid = T3.uuid WHERE T2.format = 'premodern' AND T3.text = 'This is a triggered mana ability.' AND T1.Side IS NULL,"SELECT COUNT(DISTINCT c.uuid)
FROM cards AS c
JOIN legalities AS l ON c.uuid = l.uuid
JOIN rulings AS r ON c.uuid = r.uuid
WHERE l.format = 'premodern'
AND r.text = 'This is a triggered mana ability.'
AND c.side IS NULL",0.6844,1,,,"COUNT(T1.id)
16
",,"['[{""COUNT(DISTINCT c.uuid)"":16}]']",0.0,0,41.4,
369,412,moderate,"What is the foreign name of the card in French of type Creature, normal layout and black border color, by artist Matthew D. Wilson?",SELECT name FROM foreign_data WHERE uuid IN ( SELECT uuid FROM cards WHERE types = 'Creature' AND layout = 'normal' AND borderColor = 'black' AND artist = 'Matthew D. Wilson' ) AND language = 'French',"SELECT f.name
FROM foreign_data AS f
JOIN cards AS c ON f.multiverseid = c.multiverseId
WHERE f.language = 'French'
  AND c.type = 'Creature'
  AND c.layout = 'normal'
  AND c.borderColor = 'black'
  AND c.artist = 'Matthew D. Wilson'",0.5493,0,,,"name
