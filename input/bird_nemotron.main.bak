436,282,challenging,What is the ratio of Hydrogen elements in molecule ID TR006? List the ratio with its label.,"WITH SubQuery AS (SELECT DISTINCT T1.atom_id, T1.element, T1.molecule_id, T2.label FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T2.molecule_id = 'TR006') SELECT CAST(COUNT(CASE WHEN element = 'h' THEN atom_id ELSE NULL END) AS REAL) / (CASE WHEN COUNT(atom_id) = 0 THEN NULL ELSE COUNT(atom_id) END) AS ratio, label FROM SubQuery GROUP BY label","SELECT CAST(SUM(CASE WHEN a.element = 'h' THEN 1 ELSE 0 END) AS REAL) / COUNT(a.element) AS ratio, m.label
FROM atom AS a
JOIN molecule AS m ON a.molecule_id = m.molecule_id
WHERE a.molecule_id = 'TR006'
GROUP BY m.label",0.2027,1,,,"ratio,label
0.3617021276595745,+
",,"['[{""ratio"":0.3617021277,""label"":""+""}]']",0.0,0,25.69,
437,327,moderate,Which non-carcinogenic molecules consisted more than 5 atoms?,"SELECT T.molecule_id FROM ( SELECT T1.molecule_id, COUNT(T2.atom_id) FROM molecule AS T1 INNER JOIN atom AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.label = '-' GROUP BY T1.molecule_id HAVING COUNT(T2.atom_id) > 5 ) t","SELECT m.molecule_id
FROM molecule AS m
JOIN atom AS a ON m.molecule_id = a.molecule_id
WHERE m.label = '-'
GROUP BY m.molecule_id
HAVING COUNT(a.atom_id) > 5",0.7874,1,,,"molecule_id
