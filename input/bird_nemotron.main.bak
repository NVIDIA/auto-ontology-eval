395,528,challenging,List the names of all the cards in the set Hour of Devastation and find the formats in which these cards are legal.,"SELECT DISTINCT T2.name , CASE WHEN T1.status = 'Legal' THEN T1.format ELSE NULL END FROM legalities AS T1 INNER JOIN cards AS T2 ON T2.uuid = T1.uuid WHERE T2.setCode IN ( SELECT code FROM sets WHERE name = 'Hour of Devastation' )","SELECT DISTINCT c.name, l.format
FROM cards AS c
JOIN sets AS s ON c.setCode = s.code
JOIN legalities AS l ON c.uuid = l.uuid
WHERE s.name = 'Hour of Devastation' AND l.status = 'Legal'",0.5048,1,,,"name,CASE WHEN T1.status = 'Legal' THEN T1.format ELSE NULL END
