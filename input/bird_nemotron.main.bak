142,1057,moderate,Calculate the average home team goal in the 2010/2011 season in the country of Poland.,SELECT CAST(SUM(t2.home_team_goal) AS REAL) / COUNT(t2.id) FROM Country AS t1 INNER JOIN Match AS t2 ON t1.id = t2.country_id WHERE t1.name = 'Poland' AND t2.season = '2010/2011',"SELECT CAST(SUM(m.home_team_goal) AS REAL) / COUNT(DISTINCT m.id) AS avg_home_team_goal
FROM Match AS m
JOIN Country AS c ON m.country_id = c.id
WHERE c.name = 'Poland' AND m.season = '2010/2011'",0.7346,1,,,"CAST(SUM(t2.home_team_goal) AS REAL) / COUNT(t2.id)
1.5041666666666667
",,"['[{""avg_home_team_goal"":1.5041666667}]']",0.0,0,26.38,
143,1058,challenging,Who has the highest average finishing rate between the highest and shortest football player?,"SELECT A FROM ( SELECT AVG(finishing) result, 'Max' A FROM Player AS T1 INNER JOIN Player_Attributes AS T2 ON T1.player_api_id = T2.player_api_id WHERE T1.height = ( SELECT MAX(height) FROM Player ) UNION SELECT AVG(finishing) result, 'Min' A FROM Player AS T1 INNER JOIN Player_Attributes AS T2 ON T1.player_api_id = T2.player_api_id WHERE T1.height = ( SELECT MIN(height) FROM Player ) ) ORDER BY result DESC LIMIT 1","SELECT p.player_name
FROM Player AS p
JOIN Player_Attributes AS pa ON p.player_fifa_api_id = pa.player_fifa_api_id
WHERE p.height = (SELECT MAX(height) FROM Player)
   OR p.height = (SELECT MIN(height) FROM Player)
GROUP BY p.player_name
ORDER BY AVG(pa.finishing) DESC
LIMIT 1",0.1012,0,,,"A
Min
",,"['[{""player_name"":""Juan Quero""}]']",1.0,1,32.92,
144,1068,moderate,"From 2010 to 2015, what was the average overall rating of players who are higher than 170?","SELECT CAST(SUM(t2.overall_rating) AS REAL) / COUNT(t2.id) FROM Player AS t1 INNER JOIN Player_Attributes AS t2 ON t1.player_api_id = t2.player_api_id WHERE t1.height > 170 AND STRFTIME('%Y',t2.`date`) >= '2010' AND STRFTIME('%Y',t2.`date`) <= '2015'","SELECT SUM(t2.overall_rating) / COUNT(t2.id) AS avg_overall_rating
FROM Player AS t1
JOIN Player_Attributes AS t2 ON t2.player_fifa_api_id = t1.player_fifa_api_id
WHERE strftime('%Y', t2.date) >= '2010' AND strftime('%Y', t2.date) <= '2015'
AND t1.height > 170",0.4863,0,,,"CAST(SUM(t2.overall_rating) AS REAL) / COUNT(t2.id)
68.85402657670379
",,"['[{""avg_overall_rating"":68}]']",0.0,0,35.26,
145,1076,challenging,"What is the difference of the average ball control score between Abdou Diallo and Aaron Appindangoye
?",SELECT CAST(SUM(CASE WHEN t1.player_name = 'Abdou Diallo' THEN t2.ball_control ELSE 0 END) AS REAL) / COUNT(CASE WHEN t1.player_name = 'Abdou Diallo' THEN t2.id ELSE NULL END) - CAST(SUM(CASE WHEN t1.player_name = 'Aaron Appindangoye' THEN t2.ball_control ELSE 0 END) AS REAL) / COUNT(CASE WHEN t1.player_name = 'Aaron Appindangoye' THEN t2.id ELSE NULL END) FROM Player AS t1 INNER JOIN Player_Attributes AS t2 ON t1.player_api_id = t2.player_api_id,"SELECT SUM(CASE WHEN p.player_name = 'Abdou Diallo' THEN pa.ball_control ELSE 0 END) / COUNT(CASE WHEN p.player_name = 'Abdou Diallo' THEN pa.id ELSE NULL END) - SUM(CASE WHEN p.player_name = 'Aaron Appindangoye' THEN pa.ball_control ELSE 0 END) / COUNT(CASE WHEN p.player_name = 'Aaron Appindangoye' THEN pa.id ELSE NULL END) AS difference
FROM Player_Attributes AS pa
JOIN Player AS p ON pa.player_fifa_api_id = p.player_fifa_api_id",0.1923,0,,,"CAST(SUM(CASE WHEN t1.player_name = 'Abdou Diallo' THEN t2.ball_control ELSE 0 END) AS REAL) / COUNT(CASE WHEN t1.player_name = 'Abdou Diallo' THEN t2.id ELSE NULL END) - CAST(SUM(CASE WHEN t1.player_name = 'Aaron Appindangoye' THEN t2.ball_control ELSE 0 END) AS REAL) / COUNT(CASE WHEN t1.player_name = 'Aaron Appindangoye' THEN t2.id ELSE NULL END)
0.7999999999999972
",,"['[{""difference"":1}]']",0.0,0,28.85,
