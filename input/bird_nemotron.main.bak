168,1133,simple,"How many football players born after the 1990s have the first name ""Aaron""?",SELECT COUNT(id) FROM Player WHERE birthday > '1990' AND player_name LIKE 'Aaron%',"SELECT COUNT(*) AS player_count
FROM Player
WHERE player_name LIKE 'Aaron%' AND birthday > '1990'",0.648,1,,,"COUNT(id)
9
",,"['[{""player_count"":9}]']",0.0,0,31.43,
169,1134,simple,What is the difference between players 6 and 23's jumping scores?,SELECT SUM(CASE WHEN t1.id = 6 THEN t1.jumping ELSE 0 END) - SUM(CASE WHEN t1.id = 23 THEN t1.jumping ELSE 0 END) FROM Player_Attributes AS t1,"SELECT MAX(CASE WHEN id = 6 THEN jumping END) - MAX(CASE WHEN id = 23 THEN jumping END) AS difference
FROM Player_Attributes
WHERE id IN (6, 23)",0.7552,1,,,"SUM(CASE WHEN t1.id = 6 THEN t1.jumping ELSE 0 END) - SUM(CASE WHEN t1.id = 23 THEN t1.jumping ELSE 0 END)
1
",,"['[{""difference"":1}]']",0.0,0,38.75,
