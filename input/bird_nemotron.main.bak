477,115,challenging,"For the branch which located in the south Bohemia with biggest number of inhabitants, what is the percentage of the male clients?",SELECT CAST(SUM(T1.gender = 'M') AS REAL) * 100 / COUNT(T1.client_id) FROM client AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id WHERE T2.A3 = 'south Bohemia' GROUP BY T2.A4 ORDER BY T2.A4 DESC LIMIT 1,"SELECT CAST(SUM(CASE WHEN c.gender = 'M' THEN 1 ELSE 0 END) AS REAL) / COUNT(c.client_id) * 100 AS male_percentage
FROM client AS c
WHERE c.district_id = (
  SELECT d.district_id
  FROM district AS d
  WHERE d.A3 = 'south Bohemia'
  ORDER BY CAST(d.A4 AS INTEGER) DESC
  LIMIT 1
)",0.2444,0,,,"CAST(SUM(T1.gender = 'M') AS REAL) * 100 / COUNT(T1.client_id)
