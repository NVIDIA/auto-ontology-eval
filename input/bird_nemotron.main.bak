496,192,moderate,What is the average amount of loan which are still on running contract with statement issuance after each transaction?,"SELECT AVG(T2.amount) FROM account AS T1 INNER JOIN loan AS T2 ON T1.account_id = T2.account_id WHERE T2.status IN ('C', 'D') AND T1.frequency = 'POPLATEK PO OBRATU'","SELECT AVG(l.amount) AS avg_loan_amount
FROM loan AS l
JOIN account AS a ON l.account_id = a.account_id
WHERE l.status IN ('C', 'D')
  AND a.frequency = 'POPLATEK PO OBRATU'",0.7857,1,,,"AVG(T2.amount)
192836.57142857142
",,"['[{""avg_loan_amount"":192836.5714285714}]']",0.0,0,86.94,
497,194,moderate,"Provide the IDs and age of the client with high level credit card, which is eligible for loans.","SELECT T1.client_id, STRFTIME('%Y', CURRENT_TIMESTAMP) - STRFTIME('%Y', T3.birth_date) FROM disp AS T1 INNER JOIN card AS T2 ON T2.disp_id = T1.disp_id INNER JOIN client AS T3 ON T1.client_id = T3.client_id WHERE T2.type = 'gold' AND T1.type = 'OWNER'","SELECT cl.client_id, CAST(strftime('%Y', '2026-09-01') AS INTEGER) - CAST(strftime('%Y', cl.birth_date) AS INTEGER) AS age
FROM client AS cl
JOIN disp AS d ON cl.client_id = d.client_id
JOIN card AS c ON d.disp_id = c.disp_id
WHERE c.type = 'gold' AND d.type = 'OWNER'",0.1927,1,,,"client_id,""STRFTIME('%Y', CURRENT_TIMESTAMP) - STRFTIME('%Y', T3.birth_date)""
