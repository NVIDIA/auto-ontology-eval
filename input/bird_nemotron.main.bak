FROM cards AS c
JOIN sets AS s ON c.setCode = s.code
WHERE s.name = 'Coldsnap'",0.8578,1,,,"CAST(SUM(CASE WHEN T1.cardKingdomFoilId IS NOT NULL AND T1.cardKingdomId IS NOT NULL THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(T1.id)
