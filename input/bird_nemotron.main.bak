280,786,moderate,How many heroes have the highest attribute value in strength?,SELECT COUNT(T1.hero_id) FROM hero_attribute AS T1 INNER JOIN attribute AS T2 ON T1.attribute_id = T2.id WHERE T2.attribute_name = 'Strength' AND T1.attribute_value = ( SELECT MAX(attribute_value) FROM hero_attribute ),"SELECT COUNT(*)
FROM hero_attribute AS ha
JOIN attribute AS a ON ha.attribute_id = a.id
WHERE a.attribute_name = 'Strength'
AND ha.attribute_value = (
  SELECT MAX(ha2.attribute_value)
  FROM hero_attribute AS ha2
  JOIN attribute AS a2 ON ha2.attribute_id = a2.id
  WHERE a2.attribute_name = 'Strength'
)",0.6602,1,,,"COUNT(T1.hero_id)
63
",,"['[{""COUNT(*)"":63}]']",0.0,0,24.73,
281,788,challenging,How many percent of female heroes were published by Marvel Comics?,SELECT CAST(COUNT(CASE WHEN T3.gender = 'Female' AND T2.publisher_name = 'Marvel Comics' THEN 1 ELSE NULL END) AS REAL) / COUNT(CASE WHEN T2.publisher_name = 'Marvel Comics' THEN 1 ELSE NULL END) * 100 FROM superhero AS T1 INNER JOIN publisher AS T2 ON T1.publisher_id = T2.id INNER JOIN gender AS T3 ON T1.gender_id = T3.id,"SELECT CAST(SUM(CASE WHEN g.gender = 'Female' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*) AS percent
FROM superhero AS s
JOIN publisher AS p ON s.publisher_id = p.id
JOIN gender AS g ON s.gender_id = g.id
WHERE p.publisher_name = 'Marvel Comics'",0.5509,1,,,"CAST(COUNT(CASE WHEN T3.gender = 'Female' AND T2.publisher_name = 'Marvel Comics' THEN 1 ELSE NULL END) AS REAL) / COUNT(CASE WHEN T2.publisher_name = 'Marvel Comics' THEN 1 ELSE NULL END) * 100
28.68217054263566
",,"['[{""percent"":28.6821705426}]']",0.0,0,55.31,
