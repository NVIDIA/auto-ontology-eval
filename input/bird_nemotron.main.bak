FROM cards AS c
JOIN foreign_data AS f ON c.uuid = f.uuid
WHERE c.isStorySpotlight = 1",0.8951,1,,,"CAST(SUM(CASE WHEN T2.language = 'French' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(T1.id)
10.0
