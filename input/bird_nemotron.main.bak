444,25,moderate,"Name schools in Riverside which the average of average math score for SAT is grater than 400, what is the funding type of these schools?","SELECT T1.sname, T2.`Charter Funding Type` FROM satscores AS T1 INNER JOIN frpm AS T2 ON T1.cds = T2.CDSCode WHERE T2.`District Name` LIKE 'Riverside%' GROUP BY T1.sname, T2.`Charter Funding Type` HAVING CAST(SUM(T1.AvgScrMath) AS REAL) / COUNT(T1.cds) > 400","SELECT s.School, s.FundingType
FROM satscores AS sat
JOIN schools AS s ON sat.cds = s.CDSCode
WHERE s.County = 'Riverside' AND sat.AvgScrMath > 400",0.5778,0,,,"sname,Charter Funding Type
