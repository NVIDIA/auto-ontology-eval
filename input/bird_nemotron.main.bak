343,707,moderate,"Among the posts with views ranging from 100 to 150, what is the comment with the highest score?",SELECT Text FROM comments WHERE PostId IN ( SELECT Id FROM posts WHERE ViewCount BETWEEN 100 AND 150 ) ORDER BY Score DESC LIMIT 1,"SELECT c.Text
FROM comments AS c
JOIN posts AS p ON c.PostId = p.Id
WHERE p.ViewCount BETWEEN 100 AND 150
ORDER BY c.Score DESC
LIMIT 1;",0.6792,1,,,"Text
""Welcome to Cross Validated David P, for more information about the site and how to ask questions, you can check out the [FAQ](http://stats.stackexchange.com/faq). Is your question just about whether the calculation is right or wrong (it is wrong, with the numbers you give on your second line the result of the operation is 0.187, rounded)? Otherwise, yes, a percentage can be as close to zero as you can imagine because it is bounded between 0 and 100 and continuous on that interval.""
",,"['[{""Text"":""Welcome to Cross Validated David P, for more information about the site and how to ask questions, you can check out the [FAQ](http:\\/\\/stats.stackexchange.com\\/faq). Is your question just about whether the calculation is right or wrong (it is wrong, with the numbers you give on your second line the result of the operation is 0.187, rounded)? Otherwise, yes, a percentage can be as close to zero as you can imagine because it is bounded between 0 and 100 and continuous on that interval.""}]']",0.0,0,22.07,
344,710,simple,"In posts with 1 comment, how many of the comments have 0 score?",SELECT COUNT(T1.id) FROM comments AS T1 INNER JOIN posts AS T2 ON T1.PostId = T2.Id WHERE T2.CommentCount = 1 AND T2.Score = 0,"SELECT COUNT(*) AS zero_score_comment_count
FROM comments AS c
JOIN posts AS p ON c.PostId = p.Id
WHERE p.CommentCount = 1 AND c.Score = 0",0.7803,0,,,"COUNT(T1.id)
