438,5,simple,How many schools with an average score in Math greater than 400 in the SAT test are exclusively virtual?,SELECT COUNT(DISTINCT T2.School) FROM satscores AS T1 INNER JOIN schools AS T2 ON T1.cds = T2.CDSCode WHERE T2.Virtual = 'F' AND T1.AvgScrMath > 400,"SELECT COUNT(*) AS school_count
FROM satscores AS s
JOIN schools AS sc ON s.cds = sc.CDSCode
WHERE s.AvgScrMath > 400 AND sc.Virtual = 'F'",0.6993,1,,,"COUNT(DISTINCT T2.School)
