135,1036,challenging,List the long name of teams with above-average build-up play passing in 2012.,"SELECT DISTINCT t4.team_long_name FROM Team_Attributes AS t3 INNER JOIN Team AS t4 ON t3.team_api_id = t4.team_api_id WHERE SUBSTR(t3.`date`, 1, 4) = '2012' AND t3.buildUpPlayPassing > ( SELECT CAST(SUM(t2.buildUpPlayPassing) AS REAL) / COUNT(t1.id) FROM Team AS t1 INNER JOIN Team_Attributes AS t2 ON t1.team_api_id = t2.team_api_id WHERE STRFTIME('%Y',t2.`date`) = '2012')","SELECT DISTINCT t.team_long_name
FROM Team_Attributes AS ta
JOIN Team AS t ON ta.team_api_id = t.team_api_id
WHERE strftime('%Y', ta.date) = '2012'
  AND ta.buildUpPlayPassing > (
    SELECT SUM(ta2.buildUpPlayPassing) * 1.0 / COUNT(ta2.buildUpPlayPassing)
    FROM Team_Attributes AS ta2
    WHERE strftime('%Y', ta2.date) = '2012'
      AND ta2.buildUpPlayPassing IS NOT NULL
  )",0.5484,1,,,"team_long_name
