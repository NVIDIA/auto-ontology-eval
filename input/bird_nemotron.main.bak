285,794,moderate,Which hero was the fastest?,SELECT T1.superhero_name FROM superhero AS T1 INNER JOIN hero_attribute AS T2 ON T1.id = T2.hero_id INNER JOIN attribute AS T3 ON T2.attribute_id = T3.id WHERE T3.attribute_name = 'Speed' ORDER BY T2.attribute_value DESC LIMIT 1,"SELECT s.superhero_name
FROM hero_attribute AS ha
JOIN attribute AS a ON ha.attribute_id = a.id
JOIN superhero AS s ON ha.hero_id = s.id
WHERE a.attribute_name = 'Speed'
ORDER BY ha.attribute_value DESC
LIMIT 1;",0.0365,1,,,"superhero_name
Air-Walker
