330,665,moderate,What is the average monthly number of links created in 2010 for posts that have no more than 2 answers?,"SELECT CAST(COUNT(T1.Id) AS REAL) / 12 FROM postLinks AS T1 INNER JOIN posts AS T2 ON T1.PostId = T2.Id WHERE T2.AnswerCount <= 2 AND STRFTIME('%Y', T1.CreationDate) = '2010'","SELECT COUNT(pl.Id) * 1.0 / 12 AS avg_monthly_links
FROM postLinks AS pl
JOIN posts AS p ON pl.RelatedPostId = p.Id
WHERE strftime('%Y', pl.CreationDate) = '2010' AND p.AnswerCount <= 2",0.6685,0,,,"CAST(COUNT(T1.Id) AS REAL) / 12
8.666666666666666
",,"['[{""avg_monthly_links"":5.8333333333}]']",0.0,0,25.21,
