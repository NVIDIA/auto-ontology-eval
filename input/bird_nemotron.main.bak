322,598,challenging,What is the percentage difference of student badges given during 2010 and 2011?,"SELECT CAST(SUM(IIF(STRFTIME('%Y', Date) = '2010', 1, 0)) AS REAL) * 100 / COUNT(Id) - CAST(SUM(IIF(STRFTIME('%Y', Date) = '2011', 1, 0)) AS REAL) * 100 / COUNT(Id) FROM badges WHERE Name = 'Student'","SELECT (CAST(COUNT(CASE WHEN strftime('%Y', Date) = '2010' THEN Name END) AS REAL) / COUNT(Name)) * 100 - (CAST(COUNT(CASE WHEN strftime('%Y', Date) = '2011' THEN Name END) AS REAL) / COUNT(Name)) * 100 AS percentage_difference
