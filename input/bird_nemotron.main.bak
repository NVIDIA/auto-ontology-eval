371,415,challenging,What percentage of cards with format commander and legal status do not have a content warning?,SELECT CAST(SUM(CASE WHEN T1.hasContentWarning = 0 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(T1.id) FROM cards AS T1 INNER JOIN legalities AS T2 ON T1.uuid = T2.uuid WHERE T2.format = 'commander' AND T2.status = 'Legal',"SELECT CAST(COUNT(CASE WHEN c.hasContentWarning = 0 THEN 1 END) AS REAL) * 100 / COUNT(c.id) AS percentage
FROM legalities AS l
JOIN cards AS c ON l.uuid = c.uuid
WHERE l.format = 'commander' AND l.status = 'legal';",0.4942,0,,,"CAST(SUM(CASE WHEN T1.hasContentWarning = 0 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(T1.id)
100.0
