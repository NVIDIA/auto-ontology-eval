400,198,challenging,On average how many carcinogenic molecules are single bonded?,"SELECT AVG(single_bond_count) FROM (SELECT T3.molecule_id, COUNT(T1.bond_type) AS single_bond_count FROM bond AS T1  INNER JOIN atom AS T2 ON T1.molecule_id = T2.molecule_id INNER JOIN molecule AS T3 ON T3.molecule_id = T2.molecule_id WHERE T1.bond_type = '-' AND T3.label = '+' GROUP BY T3.molecule_id) AS subquery","SELECT CAST(SUM(CASE WHEN b.bond_type = '-' THEN 1 ELSE 0 END) AS REAL) / COUNT(b.bond_id) AS avg_single_bonded
FROM bond AS b
JOIN molecule AS m ON b.molecule_id = m.molecule_id
WHERE m.label = '+'",0.4102,0,,,"AVG(single_bond_count)
732.125
",,"['[{""avg_single_bonded"":0.8285329744}]']",0.0,0,28.43,
