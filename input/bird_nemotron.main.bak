397,530,moderate,List all the frame styles and cards Allen Williams worked on and find any banned cards if there are any.,"SELECT DISTINCT T1.frameVersion, T1.name , IIF(T2.status = 'Banned', T1.name, 'NO') FROM cards AS T1 INNER JOIN legalities AS T2 ON T1.uuid = T2.uuid WHERE T1.artist = 'Allen Williams'","SELECT c.frameVersion, c.name, l.status
FROM cards AS c
LEFT JOIN legalities AS l ON c.uuid = l.uuid AND l.status = 'Banned'
WHERE c.artist = 'Allen Williams'
ORDER BY c.name",0.6872,0,,,"frameVersion,name,""IIF(T2.status = 'Banned', T1.name, 'NO')""
