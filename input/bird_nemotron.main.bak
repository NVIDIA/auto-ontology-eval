365,405,moderate,How many Brazilian Portuguese translated sets are inside the Commander block?,SELECT COUNT(T1.id) FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.language = 'Portuguese (Brazil)' AND T1.block = 'Commander',"SELECT COUNT(*) AS num_sets
FROM set_translations AS st
JOIN sets AS s ON st.setCode = s.code
WHERE st.language = 'Portuguese (Brasil)'
  AND s.block = 'Commander'",0.7678,0,,,"COUNT(T1.id)
7
",,"['[{""num_sets"":0}]']",0.0,0,23.71,
