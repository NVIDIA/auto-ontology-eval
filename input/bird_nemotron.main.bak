328,639,challenging,"Based on posts posted by Community, calculate the percentage of posts that use the R language.","SELECT CAST(SUM(IIF(T3.TagName = 'r', 1, 0)) AS REAL) * 100 / COUNT(T1.Id) FROM users AS T1 INNER JOIN postHistory AS T2 ON T1.Id = T2.UserId INNER JOIN tags AS T3 ON T3.ExcerptPostId = T2.PostId WHERE T1.DisplayName = 'Community'",SELECT CAST(COUNT(CASE WHEN Tags LIKE '%<r>%' THEN 1 END) AS REAL) * 100 / COUNT(CASE WHEN OwnerDisplayName = 'Community' THEN 1 END) AS percentage FROM posts,0.4072,0,,,"""CAST(SUM(IIF(T3.TagName = 'r', 1, 0)) AS REAL) * 100 / COUNT(T1.Id)""
