# Copy to .env and fill in your values.

# Model-endpoint triplets. Every triplet has three fields:
#   <PREFIX>_ENDPOINT (URL) / <PREFIX>_API_KEY / <PREFIX>_MODEL
# Any field left unset falls back to the matching DEFAULT_MODELS_ value below, so a
# single DEFAULT_MODELS_ triplet can supply the shared endpoint/key/model for all of
# them. Only set the per-triplet fields that need to differ from the default.
# When DEFAULT_MODELS_* is also unset, built-in defaults are chosen from the API
# key prefix (sk- → inference-api.nvidia.com, nvapi- → integrate.api.nvidia.com).

# --- Default triplet (fallback for every field of every triplet below) ---
DEFAULT_MODELS_API_KEY=your-api-key-here
# DEFAULT_MODELS_ENDPOINT=https://inference-api.nvidia.com/v1
# DEFAULT_MODELS_MODEL=aws/anthropic/bedrock-claude-opus-4-8

# --- Agent LLM (text-to-SQL agent, used during retrieval eval) ---
# REASONING_API_KEY falls back to DEFAULT_MODELS_API_KEY (then legacy NVIDIA_API_KEY).
# REASONING_API_KEY=your-api-key-here
# REASONING_ENDPOINT=https://inference-api.nvidia.com/v1
# REASONING_MODEL=aws/anthropic/bedrock-claude-opus-4-8

# --- Judge LLM (ontology-sql-eval scorer) ---
# Each JUDGE_* var falls back to DEFAULT_MODELS_*, then legacy NVIDIA_API_KEY /
# BASE_URL / MODEL_NAME, then a built-in default for the key prefix (sk- vs nvapi-).
# JUDGE_API_KEY=your-api-key-here
# JUDGE_BASE_URL=https://inference-api.nvidia.com/v1
# JUDGE_MODEL_NAME=nvidia/nvidia/Nemotron-3-Nano-30B-A3B

# --- Embeddings (used by ingestion + retrieval eval) ---
# MUST be identical for ingest and query, otherwise stored vectors and query
# vectors live in different spaces.
# EMBED_API_KEY=your-api-key-here
# EMBED_ENDPOINT=https://inference-api.nvidia.com/v1
# EMBED_MODEL=nvidia/nvidia/llama-nemotron-embed-vl-1b-v2

# --- Non-reasoning model (e.g. entity extraction) ---
# Has its own key/endpoint/model so it can point at a different endpoint than the
# main reasoning model. ENDPOINT/MODEL fall back to the REASONING_* values.
# NON_REASONING_API_KEY=your-api-key-here
# NON_REASONING_ENDPOINT=https://inference-api.nvidia.com/v1
# NON_REASONING_MODEL=azure/openai/gpt-4.1-mini

# --- Neo4j (graph store; from GSF's docker-compose) ---
# bolt://neo4j:7687     — when running inside Docker (service name as host)
# bolt://localhost:7687 — when running Python scripts on your host machine
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# --- Postgres pgvector store (from GSF's docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=gsf

# --- Source database that ontology_sql_eval/ingestion/ingest.py extracts schema from ---
# If you seeded a local DB via scripts/seed_wwi.py, point this at it, e.g.:
#   CONNECTION_STRINGS=postgresql://postgres:password@localhost:5432/wideworldimporters
# For BIRD, point at the SQLite files (comma-separated), e.g.:
#   CONNECTION_STRINGS=sqlite:////abs/path/datasets/bird/formula_1/formula_1.sqlite,...
CONNECTION_STRINGS=postgresql://user:password@host:5432/wideworldimporters
