# Copy to .env and fill in your values.

# --- Agent LLM (text-to-SQL agent, used during retrieval eval) ---
NVIDIA_API_KEY=your-api-key-here
BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b

# --- Judge LLM (evaluation-judge scorer) ---
# Independent of the agent LLM above; each JUDGE_* var falls back to its shared
# counterpart (NVIDIA_API_KEY / BASE_URL / MODEL_NAME) when unset.
JUDGE_API_KEY=your-api-key-here
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b

# --- Embeddings (used by ingestion + retrieval eval) ---
# MUST be identical for ingest and query, otherwise stored vectors and query
# vectors live in different spaces.
EMBED_API_KEY=your-api-key-here
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2

# --- Neo4j (graph store; from GSF's docker-compose) ---
# bolt://neo4j:7687     — when running inside Docker (service name as host)
# bolt://localhost:7687 — when running Python scripts on your host machine
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# --- Postgres pgvector store (from GSF's docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=gsf
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Source database that evaluation/ingestion/pipeline.py extracts schema from ---
# Examples:
#   CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
#   CONNECTION_STRINGS=snowflake://user:pass@account?warehouse=WH&database=DB
#   CONNECTION_STRINGS=duckdb:///absolute/path/to/file.duckdb
CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
