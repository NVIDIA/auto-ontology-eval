# Copy to .env and fill in your values.
# --- Agent LLM (text-to-SQL agent, used during retrieval eval) ---
# NVIDIA_API_KEY=your-integrate-api-key-here
# BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_API_KEY=your-api-key-here
BASE_URL=https://inference-api.nvidia.com/v1
MODEL_NAME=nvidia/nvidia/Nemotron-3-Nano-30B-A3B
# --- Judge LLM (sql-eval-judge scorer) ---
# Independent of the agent LLM above; each JUDGE_* var falls back to its shared
# counterpart (NVIDIA_API_KEY / BASE_URL / MODEL_NAME) when unset.
JUDGE_API_KEY=your-integrate-api-key-here
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b
# --- Embeddings (used by ingestion + retrieval eval) ---
# MUST be identical for ingest and query, otherwise stored vectors and query
# vectors live in different spaces.
EMBED_API_KEY=your-integrate-api-key-here
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
# Reranking (used by the rerank flow's rerank_sql_results node).
# RERANK_API_KEY falls back to NVIDIA_API_KEY when unset.
RERANK_ENDPOINT=https://inference-api.nvidia.com/v1/rerank
RERANK_MODEL=nvidia/nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANK_API_KEY=your-api-key-here
RERANK_PRODUCT_HUB_QUERY=product_id
# Non-reasoning model, e.g. for entity extraction. Has its own key/base URL/model
# so it can point at a different endpoint (e.g. inference API) than the main model.
NON_REASONING_NVIDIA_API_KEY=your-api-key-here
NON_REASONING_BASE_URL=https://inference-api.nvidia.com/v1
NON_REASONING_MODEL_NAME=azure/openai/gpt-4.1-mini
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=gsf
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Source database that ontology_sql_eval/ingestion/ingest.py extracts schema from ---
# If you seeded a local DB via scripts/seed_wwi.py, point this at it, e.g.:
#   CONNECTION_STRINGS=postgresql://postgres:password@localhost:5432/wideworldimporters
# For BIRD Mini-Dev (SQLite), list the databases comma-separated:
#   CONNECTION_STRINGS=sqlite:////absolute/path/datasets/bird/california_schools/california_schools.sqlite,sqlite:////absolute/path/datasets/bird/card_games/card_games.sqlite
# Examples:
#   CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
CONNECTION_STRINGS=postgresql://user:password@host:5432/wideworldimporters
